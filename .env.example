# App
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW="1 minute"

# Database
DATABASE_URL="postgresql://postgres:root@localhost:5432/shopwus?schema=public"
# Optional: leave empty when your provider does not supply a direct connection URL.
DIRECT_URL=""

# Cloudflare R2
CLOUDFLARE_R2_ACCESS_KEY=mock-access-key
CLOUDFLARE_R2_SECRET_KEY=mock-secret-key
CLOUDFLARE_R2_ACCOUNT_ID=mock-account-id
CLOUDFLARE_R2_BUCKET_NAME=mock-bucket-name
CLOUDFLARE_R2_PUBLIC_URL=https://pub-mock.r2.dev

# Resend
RESEND_API_KEY=re_mock_key
RESEND_FROM_EMAIL=hello@shopwus.com
ADMIN_EMAIL=admin@shopwus.com

# JWT & Auth
JWT_SECRET="super-secret-default-key-change-it-in-prod"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="1d"
JWT_REMEMBER_ME_EXPIRES_IN="30d"
FRONTEND_URL="http://localhost:5173"
CORS="http://localhost:5173,http://127.0.0.1:5173"

# Social Auth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id

# Monitoring & SMS / WhatsApp (Optional)
SENTRY_DSN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
TWILIO_WHATSAPP_OTP_TEMPLATE_SID=HXb2beee08d937dbcfd50db8aa9fe833a3

APP_DEFAULT_TIMEZONE="Africa/Lagos"
BOOTSTRAP_SECRET="bstrap_X7kP9aQzL4nR2vW8jT6hY1cF3sDar5"
MANUAL_EMAIL_PASSWORD=super-secure-manual-password-1234

# PDF Generation (Optional: for connecting to a remote Chrome instance like Browserless.io)
# PUPPETEER_WS_ENDPOINT="wss://chrome.browserless.io?token=your-api-key"
# PUPPETEER_WS_ENDPOINT_BACKUP="wss://chrome.browserless.io?token=your-backup-api-key"

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY="sk_test_mock"
PAYSTACK_PUBLIC_KEY="pk_test_mock"

# Terminal Africa Shipping API
TERMINAL_ENVIRONMENT=sandbox
TERMINAL_PUBLIC_KEY=pk_test_mock
TERMINAL_SECRET_KEY=sk_test_mock
TERMINAL_BASE_URL=https://sandbox.terminal.africa/v1

# Logistics Sweep & Treasury Configuration
ADMIN_PRIVATE_SECRET="sw_admin_sec_replace_with_secure_random_key"
