doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Welcome to Shopwus
    style.
      body {
        font-family: Arial, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      .header {
        background: #f4f4f4;
        padding: 20px;
        text-align: center;
        border-radius: 8px 8px 0 0;
      }
      .content {
        padding: 20px;
        border: 1px solid #eee;
        border-top: none;
        border-radius: 0 0 8px 8px;
      }
      .button {
        display: inline-block;
        padding: 10px 20px;
        background-color: #007bff;
        color: #fff;
        text-decoration: none;
        border-radius: 5px;
        margin-top: 20px;
      }
  body
    .header
      h1 Welcome, #{name}!
    .content
      p Hi #{name},
      p We're excited to have you join Shopwus. Your account is now active and ready to go.
      p Explore our features and let us know if you have any questions.
      a.button(href=url) Go to Dashboard
      p Best regards,
      p The Shopwus Team
