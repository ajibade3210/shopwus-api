doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(http-equiv="X-UA-Compatible" content="IE=edge")
    title Reset Your Shopwus Password
    style.
      @media only screen and (max-width: 600px) {
        .email-container { width: 100% !important; padding: 12px !important; }
        .email-header { padding: 0 !important; }
        .email-body { padding: 24px 20px !important; }
        .hero-title { font-size: 20px !important; }
        .otp-code { font-size: 28px !important; letter-spacing: 6px !important; }
        .btn { display: block !important; width: 100% !important; text-align: center !important; box-sizing: border-box !important; }
      }

  body(style="margin:0;padding:0;background-color:#f4f6f9;font-family:'Inter',Arial,sans-serif;-webkit-font-smoothing:antialiased;")
    table(role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#f4f6f9;padding:32px 0;")
      tr
        td(align="center")
          table.email-container(role="presentation" cellpadding="0" cellspacing="0" border="0" width="580" style="max-width:580px;width:100%;background-color:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.06);border:1px solid #e9ecef;")
            tr
              td.email-header(style="padding:0;line-height:0;font-size:0;background-color:#0f172a;")
                img(src=headerBannerUrl alt="Shopwus" width="580" style="display:block;width:100%;max-width:100%;height:auto;border:0;")

            tr
              td(style="background-color:#f8fafc;padding:12px 32px;border-bottom:1px solid #e2e8f0;")
                table(role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto;")
                  tr
                    td(style="vertical-align:middle;padding-right:8px;width:72px;")
                      img(src=logoUrl alt="Shopwus" width="72" height="72" style="display:block;width:72px;height:72px;object-fit:contain;")
                    td(style="vertical-align:middle;text-align:left;")
                      p.hero-title(style="font-size:20px;font-weight:700;color:#0f172a;margin:0 0 4px 0;") Password Reset Request

            tr
              td.email-body(style="padding:32px;font-size:15px;color:#334155;line-height:1.6;")
                p(style="margin:0 0 16px;font-size:16px;color:#0f172a;") Hi #[strong #{name || 'there'}],
                p(style="margin:0 0 20px;") We received a request to reset the password for your Shopwus account. You can use the 6-digit code below or click the button to reset your password immediately:

                table(role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:24px 0;")
                  tr
                    td(align="center")
                      div(style="background-color:#0f172a;border-radius:10px;padding:18px 32px;display:inline-block;border:1px solid #1e293b;")
                        span.otp-code(style="font-family:'Courier New',Courier,monospace;font-size:32px;font-weight:700;letter-spacing:8px;color:#ffffff;display:inline-block;padding-left:8px;") #{otp}

                if resetUrl
                  table(role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px auto;")
                    tr
                      td(align="center")
                        a.btn(href=resetUrl style="display:inline-block;padding:14px 32px;background-color:#0f172a;color:#ffffff;text-decoration:none;font-weight:600;font-size:14px;border-radius:8px;letter-spacing:0.2px;") Reset Password Directly &rarr;

                p(style="margin:20px 0 8px;font-size:13px;color:#64748b;text-align:center;")
                  | This code and link will expire in #[strong #{expiryMinutes || 15} minutes].

                p(style="margin:24px 0 0;font-size:13px;color:#94a3b8;border-top:1px solid #f1f5f9;padding-top:16px;")
                  | If you did not request a password reset, please ignore this email. Your password will remain unchanged.

            tr
              td(style="background-color:#f8fafc;padding:20px 32px;border-top:1px solid #e2e8f0;text-align:center;font-size:12px;color:#94a3b8;")
                p(style="margin:0;") &copy; #{currentYear} Shopwus. All rights reserved.
