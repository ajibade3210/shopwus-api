doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(http-equiv="X-UA-Compatible" content="IE=edge")
    meta(name="x-apple-disable-message-reformatting")
    meta(name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no")
    title= title + " | Accessa"
    style.
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');

      * { margin: 0; padding: 0; box-sizing: border-box; }

      body, #bodyTable {
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        background-color: #f4f4f7;
      }

      img {
        border: 0;
        outline: none;
        text-decoration: none;
        -ms-interpolation-mode: bicubic;
      }

      a { text-decoration: none; }

      /* Prevent blue links on iOS */
      a[x-apple-data-detectors] {
        color: inherit !important;
        text-decoration: none !important;
      }

      /* Gmail override */
      u + #body a {
        color: inherit;
        text-decoration: none;
      }

      @media only screen and (max-width: 600px) {
        .email-wrapper { width: 100% !important; }
        .email-body { padding: 24px 16px !important; }
        .otp-digit { width: 40px !important; height: 40px !important; font-size: 20px !important; }
      }

  body(id="body" style="margin:0;padding:0;background-color:#f4f4f7;")
    //- Outer wrapper table
    table(role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#f4f4f7;")
      tr
        td(align="center" style="padding:40px 16px;")

          //- Email container
          table.email-wrapper(role="presentation" cellpadding="0" cellspacing="0" border="0" width="560" style="max-width:560px;background-color:#ffffff;border-radius:8px;overflow:hidden;")

            //- Logo Header
            tr
              td(style="padding:24px 32px;border-bottom:1px solid #f3f4f6;")
                table(role="presentation" cellpadding="0" cellspacing="0" border="0")
                  tr
                    td(style="vertical-align:middle;padding-right:10px;")
                      img(
                        src="https://res.cloudinary.com/dbyxa5mev/image/upload/v1774002433/accessa_logo_rekkfp.jpg"
                        alt="Accessa Logo"
                        height="42"
                        style="display:block;border-radius:6px;"
                      )

            //- Body
            tr
              td.email-body(style="padding:40px 32px;font-family:'Inter',Arial,sans-serif;color:#1a1a2e;")

                //- Title
                p(style="font-size:24px;font-weight:700;color:#1a73e8;margin:0 0 24px 0; text-align:center;") #{title}

                //- Greeting
                p(style="font-size:15px;color:#374151;margin:0 0 12px 0;") Hi #{name},

                //- Description
                p(style="font-size:14px;color:#6b7280;line-height:1.7;margin:0 0 24px 0;")= description

                //- OTP Label
                p(style="font-size:14px;font-weight:700;color:#1a1a2e;margin:0 0 16px 0;") Reset Password Code:

                //- OTP Digits
                table(role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 24px 0;")
                  tr
                    td(align="center")
                      table(role="presentation" cellpadding="0" cellspacing="8" border="0")
                        tr
                          - const digits = String(otp).split('')
                          each digit in digits
                            td
                              span.otp-digit(style="display:inline-block;width:52px;height:52px;line-height:52px;text-align:center;border:1.5px solid #d1d5db;border-radius:8px;font-size:24px;font-weight:600;color:#1a1a2e;font-family:'Inter',Arial,sans-serif;")= digit

                //- Expiry note
                p(style="font-size:14px;color:#374151;line-height:1.6;margin:0 0 12px 0;")
                  | This code will expire in&nbsp;
                  strong(style="color:#ef4444;") #{expiryMinutes} minutes
                  | &nbsp;for security reasons.

                //- Security note
                p(style="font-size:14px;color:#374151;line-height:1.6;margin:0 0 32px 0;")
                  | If you did not create an ACCESSA account, please ignore this email.

                //- CTA Button
                table(role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 40px 0;")
                  tr
                    td(align="center")
                      a(
                        href=resetUrl
                        target="_blank"
                        style="display:inline-block;padding:16px 40px;background:linear-gradient(90deg,#1a73e8 0%,#38bdf8 100%);color:#ffffff;font-size:15px;font-weight:600;font-family:'Inter',Arial,sans-serif;border-radius:8px;text-decoration:none;"
                      ) Reset Password

            //- Divider
            tr
              td(style="padding:0 32px;")
                table(role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%")
                  tr
                    td(style="border-top:1px solid #f3f4f6;font-size:0;line-height:0;") &nbsp;

            //- Footer
            tr
              td(style="padding:24px 32px 32px;font-family:'Inter',Arial,sans-serif;text-align:center;")

                p(style="font-size:13px;color:#6b7280;margin:0 0 6px 0;")
                  | Need help? Contact our support team at&nbsp;
                  a(href="mailto:contact@accessa.ng" style="color:#1a73e8;text-decoration:none;") contact@accessa.ng

                p(style="font-size:12px;color:#9ca3af;margin:0 0 20px 0;")
                  | © #{currentYear} ACCESSA, FCT Nigeria.

                //- Social Icons
                table(role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto;")
                  tr
                    td(style="padding:0 8px;")
                      a(href="https://x.com/accessatechltd?s=11" target="_blank" aria-label="Twitter" style="display:inline-block;width:32px;height:32px;line-height:32px;text-align:center;border-radius:50%;background-color:#f3f4f6;color:#374151;font-size:15px;font-family:'Inter',Arial,sans-serif;text-decoration:none;") 𝕏
                    td(style="padding:0 8px;")
                      a(href="https://facebook.com" target="_blank" aria-label="Facebook" style="display:inline-block;width:32px;height:32px;line-height:32px;text-align:center;border-radius:50%;background-color:#f3f4f6;color:#374151;font-size:15px;font-family:'Inter',Arial,sans-serif;text-decoration:none;") f
                    td(style="padding:0 8px;")
                      a(href="https://linkedin.com" target="_blank" aria-label="LinkedIn" style="display:inline-block;width:32px;height:32px;line-height:32px;text-align:center;border-radius:50%;background-color:#f3f4f6;color:#374151;font-size:15px;font-family:'Inter',Arial,sans-serif;text-decoration:none;") in