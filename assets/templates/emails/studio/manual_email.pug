doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(http-equiv="X-UA-Compatible" content="IE=edge")
    title= subject || (studioName ? `Message from ${studioName}` : 'Studio Message')
    style.
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { background-color: #f4f6f9; font-family: 'Inter', Arial, sans-serif; -webkit-font-smoothing: antialiased; }
      a { color: #0058be; text-decoration: none; }
      p { margin-bottom: 16px; }
      @media only screen and (max-width: 600px) {
        .email-container { width: 100% !important; padding: 12px !important; }
        .email-body { padding: 24px 20px !important; }
      }

  body(style="margin:0;padding:0;background-color:#f4f6f9;")
    table(role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#f4f6f9;padding:32px 0;")
      tr
        td(align="center")
          table.email-container(role="presentation" cellpadding="0" cellspacing="0" border="0" width="580" style="max-width:580px;width:100%;background-color:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.06);border:1px solid #e9ecef;")

            //- Header Banner (ONLY Studio Email Header if configured in DB; NEVER platform headerBannerUrl)
            if studioHeaderUrl
              tr
                td(style="padding:0;line-height:0;font-size:0;background-color:#0f172a;")
                  img(src=studioHeaderUrl alt=(studioName || 'Studio') width="580" style="display:block;width:100%;max-width:100%;height:auto;border:0;")

            //- Body
            tr
              td.email-body(style="padding:32px;font-family:'Inter',Arial,sans-serif;color:#374151;font-size:15px;line-height:1.7;white-space:pre-line;")
                if recipientName
                  p(style="font-size:16px;font-weight:600;color:#111827;margin-bottom:16px;") Hi #{recipientName},
                if messageBody
                  | #{messageBody}
                else if body
                  != body

            //- Footer
            tr
              td(style="padding:24px 32px;border-top:1px solid #f3f4f6;background-color:#f9fafb;font-family:'Inter',Arial,sans-serif;")
                p(style="font-size:13px;color:#9ca3af;margin:0;")
                  | Sent by&nbsp;
                  strong(style="color:#6b7280;") #{senderName || studioName || 'Our Studio'}
                p(style="font-size:12px;color:#d1d5db;margin-top:8px;") &copy; #{currentYear} #{studioName || 'Shopwus'}. All rights reserved.
