doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(http-equiv="X-UA-Compatible" content="IE=edge")
    title Welcome to Shopwus
    style.
      @media only screen and (max-width: 600px) {
        .email-container { width: 100% !important; padding: 12px !important; }
        .email-header { padding: 24px 20px 20px !important; }
        .email-body { padding: 24px 20px !important; }
        .hero-title { font-size: 20px !important; }
        .btn { display: block !important; width: 100% !important; text-align: center !important; box-sizing: border-box !important; }
      }

  body(style="margin:0;padding:0;background-color:#f4f6f9;font-family:'Inter',Arial,sans-serif;-webkit-font-smoothing:antialiased;")
    table(role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#f4f6f9;padding:32px 0;")
      tr
        td(align="center")
          table.email-container(role="presentation" cellpadding="0" cellspacing="0" border="0" width="580" style="max-width:580px;width:100%;background-color:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.06);border:1px solid #e9ecef;")
            tr
              td.email-header(style="background-color:#0f172a;padding:32px 32px 28px;text-align:center;")
                h1(style="font-size:24px;font-weight:800;color:#ffffff;letter-spacing:-0.5px;margin:0 0 6px 0;") Shopwus
                p(style="font-size:13px;color:#94a3b8;margin:0;") Creative Studio & Client Operations Platform

            tr
              td(style="background-color:#f8fafc;padding:24px 32px;border-bottom:1px solid #e2e8f0;text-align:center;")
                p.hero-title(style="font-size:20px;font-weight:700;color:#0f172a;margin:0 0 6px 0;") Welcome to Shopwus! 🎉
                if studioName
                  p(style="font-size:14px;color:#64748b;margin:0;") Your studio #[strong #{studioName}] is ready.

            tr
              td.email-body(style="padding:32px;font-size:15px;color:#334155;line-height:1.6;")
                p(style="margin:0 0 16px;") Hi #{name},
                p(style="margin:0 0 24px;") Welcome aboard! Your studio workspace has been created. You can now showcase your portfolio, manage client leads, create service scopes, and dispatch invoices seamlessly.

                table(role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0;")
                  tr
                    td
                      a.btn(href=url style="display:inline-block;padding:12px 28px;background-color:#0f172a;color:#ffffff;text-decoration:none;font-weight:600;font-size:14px;border-radius:6px;") Go to Dashboard

            tr
              td(style="background-color:#f8fafc;padding:20px 32px;border-top:1px solid #e2e8f0;text-align:center;font-size:12px;color:#94a3b8;")
                p(style="margin:0;") &copy; #{currentYear} Shopwus. All rights reserved.
