doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(http-equiv="X-UA-Compatible" content="IE=edge")
    title Welcome to Shopwus
    style.
      @media only screen and (max-width: 600px) {
        .email-container { width: 100% !important; padding: 12px !important; }
        .email-header { padding: 0 !important; }
        .email-body { padding: 24px 20px !important; }
        .hero-title { font-size: 20px !important; }
        .btn { display: block !important; width: 100% !important; text-align: center !important; box-sizing: border-box !important; }
      }

  body(style="margin:0;padding:0;background-color:#f4f6f9;font-family:'Inter',Arial,sans-serif;-webkit-font-smoothing:antialiased;")
    table(role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#f4f6f9;padding:32px 0;")
      tr
        td(align="center")
          table.email-container(role="presentation" cellpadding="0" cellspacing="0" border="0" width="580" style="max-width:580px;width:100%;background-color:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.06);border:1px solid #e9ecef;")
            tr
              td.email-header(style="padding:0;line-height:0;font-size:0;background-color:#0f172a;")
                img(src="https://pub-d89922cb03b54e33ae779d915f49c77f.r2.dev/test/accessa/cmtgyit0u00006g9ko2ifxfh3/images/48cb6dca8f7327b62ed89883ef9f535d.png" alt="Shopwus" width="580" style="display:block;width:100%;max-width:100%;height:auto;border:0;")

            tr
              td(style="background-color:#f8fafc;padding:12px 32px;border-bottom:1px solid #e2e8f0;")
                table(role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto;")
                  tr
                    td(style="vertical-align:middle;padding-right:8px;width:72px;")
                      img(src="https://pub-d89922cb03b54e33ae779d915f49c77f.r2.dev/test/shopwus/cmthmkmof0028xh9kg6nu5t4y/images/dbd8a9b9329635870455adebb7e17f3b.png" alt="Shopwus" width="72" height="72" style="display:block;width:72px;height:72px;object-fit:contain;")
                    td(style="vertical-align:middle;text-align:left;")
                      p.hero-title(style="font-size:20px;font-weight:700;color:#0f172a;margin:0 0 4px 0;") Welcome to Shopwus!
                      if studioName
                        p(style="font-size:14px;color:#64748b;margin:0;") Your Storefront #[strong #{studioName}] is ready.

            tr
              td.email-body(style="padding:32px;font-size:15px;color:#334155;line-height:1.6;")
                p(style="margin:0 0 16px;font-size:16px;color:#0f172a;") Hi #[strong #{name}],
                p(style="margin:0 0 20px;") Welcome to Shopwus! Your storefront workspace is officially live and ready for your customers.
                
                p(style="margin:0 0 12px;font-weight:600;color:#0f172a;") Here is what you can do right away:
                ul(style="margin:0 0 24px 0;padding-left:20px;color:#475569;")
                  li(style="margin-bottom:8px;") #[strong Showcase your offerings] &mdash; publish your products and services.
                  li(style="margin-bottom:8px;") #[strong Capture client leads] &mdash; receive booking and quote inquiries directly through your storefront.
                  li(style="margin-bottom:8px;") #[strong Send invoices & get paid] &mdash; create professional invoices and collect payments seamlessly.

                table(role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:28px 0 0 0;")
                  tr
                    td
                      a.btn(href=url style="display:inline-block;padding:14px 32px;background-color:#0f172a;color:#ffffff;text-decoration:none;font-weight:600;font-size:14px;border-radius:8px;letter-spacing:0.2px;") Go to Your Dashboard &rarr;

                p(style="margin:24px 0 0;font-size:13px;color:#64748b;line-height:1.5;") Need help getting started? Contact us at #[a(href="mailto:contact@shopwus.com" style="color:#0f172a;font-weight:600;text-decoration:underline;") contact@shopwus.com] &mdash; we&rsquo;re here to assist you.

            tr
              td(style="background-color:#f8fafc;padding:20px 32px;border-top:1px solid #e2e8f0;text-align:center;font-size:12px;color:#94a3b8;")
                p(style="margin:0;") &copy; #{currentYear} Shopwus. All rights reserved.
