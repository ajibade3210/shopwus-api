{
  "name": "fastify-api",
  "version": "1.0.0",
  "description": "Fastify + Prisma + PostgreSQL API",
  "main": "dist/server.js",
  "private": true,
  "resolutions": {
    "fastify": "^5.8.2"
  },
  "license": "UNLICENSED",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "rm -rf dist && tsc",
    "start": "node --max-old-space-size=384 dist/server.js",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "format": "biome check --write .",
    "lint": "biome lint --write",
    "test": "jest --forceExit",
    "test:unit": "jest --testPathPatterns=tests/unit --runInBand --detectOpenHandles --forceExit",
    "test:integration": "jest --testPathPatterns=tests/integration --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "jest --coverage --runInBand",
    "check": "tsc --noEmit",
    "check:console": "bash scripts/check-console-logs.sh",
    "prepare": "husky",
    "postinstall": "prisma generate && husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1054.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@sentry/node": "^10.45.0",
    "argon2": "^0.44.0",
    "axios": "^1.13.6",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.8.2",
    "fastify-plugin": "^5.0.1",
    "fastify-socket.io": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "ms": "^2.1.3",
    "pg": "^8.20.0",
    "pg-boss": "^12.14.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.1.3",
    "pug": "^3.0.4",
    "puppeteer": "^24.41.0",
    "qrcode": "^1.5.4",
    "resend": "^6.9.4",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "twilio": "^5.13.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "@jest/globals": "^30.0.0",
    "@testcontainers/postgresql": "^11.12.0",
    "@types/dockerode": "^3.3.34",
    "@types/exceljs": "^1.3.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.11.11",
    "@types/pug": "^2.0.10",
    "@types/qrcode": "^1.5.6",
    "@prisma/config": "^7.5.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "prisma": "^7.5.0",
    "testcontainers": "^11.12.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
