enum TransactionStatus {
  SUCCESS
  FAILED
  REFUNDED
}

model BusinessBilling {
  id                 String    @id @default(cuid())
  businessId         String    @unique
  paystackSubaccount String?
  bankCode           String?
  bankName           String?
  accountNumber      String?
  accountName        String?
  isVerified         Boolean   @default(false)
  planTier           String    @default("FREE")
  platformFeePercent Decimal   @default(2.5) @db.Decimal(5, 2)
  subscriptionStatus String    @default("ACTIVE")
  subscriptionCode   String?
  currentPeriodEnd   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([id, businessId])
  @@index([businessId])
}

model PaymentTransaction {
  id                 String            @id @default(cuid())
  orderId            String
  businessId         String
  reference          String            @unique
  amount             Decimal           @db.Decimal(12, 2)
  platformFee        Decimal           @default(0) @db.Decimal(12, 2)
  gatewayFee         Decimal           @default(0) @db.Decimal(12, 2)
  merchantSettlement Decimal           @db.Decimal(12, 2)
  currency           String            @default("NGN")
  channel            String?
  status             TransactionStatus @default(SUCCESS)
  rawWebhookData     Json?
  paidAt             DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  business           Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([id, businessId])
  @@index([businessId])
  @@index([orderId])
  @@index([reference])
}
