model Business {
  id                String             @id @default(cuid())
  slug              String             @unique
  name              String
  tagline           String?
  description       String?
  location          String?
  website           String?
  email             String?
  phone             String?
  whatsAppNumber    String?
  operatingHours    String?
  timeFrom          String?
  timeTo            String?
  byAppointmentOnly Boolean            @default(false)
  logoUrl           String?
  businessType      String             @default("sales")
  currency          String             @default("NGN")
  colors              Json?
  buttonRadius        String?            @default("Subtle")
  showServices        Boolean            @default(true)
  showPortfolio       Boolean            @default(true)
  showReviews         Boolean            @default(true)
  showFooterCta       Boolean            @default(true)
  footerEyebrow       String?
  footerTitle         String?
  footerDescription   String?
  googleReviewsLink   String?
  portfolioCategories String[]           @default([])
  isPublished         Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  businessUsers      BusinessUser[]
  socialChannels     SocialChannel[]
  portfolioProjects  PortfolioProject[]
  reviews            Review[]
  services           Service[]
  customers          Customer[]
  customerServices   CustomerService[]
  leads              Lead[]
  invoices           Invoice[]
  expenses           Expense[]
  broadcastCampaigns BroadcastCampaign[]
  feedbackRequests   FeedbackRequest[]
  valuationRecords   ValuationRecord[]
  documentSequences  DocumentSequence[]

  @@index([slug])
}

model BusinessUser {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  role       Role     @default(OWNER)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
}

model Service {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  category    String?
  description String?
  price       Decimal? @db.Decimal(12, 2)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([id, businessId])
  @@index([businessId])
}

model SocialChannel {
  id          String    @id @default(cuid())
  businessId  String
  type        String
  connected   Boolean   @default(false)
  label       String?
  handle      String?
  url         String?
  description String?
  lastSynced  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([id, businessId])
  @@index([businessId])
}

model PortfolioProject {
  id          String   @id @default(cuid())
  businessId  String
  title       String
  category    String?
  location    String?
  description String?
  image       String?
  order       Int      @default(0)
  isCover     Boolean  @default(false)
  gallery     String[] @default([])
  stats       String?
  client      String?
  year        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([id, businessId])
  @@index([businessId])
}

model Review {
  id         String   @id @default(cuid())
  businessId String
  author     String
  role       String?
  eventType  String?
  rating     Int      @default(5)
  comment    String
  date       String?
  avatar     String?
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([id, businessId])
  @@index([businessId])
}
