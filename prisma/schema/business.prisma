model Business {
  id                String             @id @default(cuid())
  slug              String             @unique
  name              String
  tagline           String?
  description       String?
  location          String?
  website           String?
  email             String?
  phone             String?
  whatsAppNumber    String?
  operatingHours    String?
  timeFrom          String?
  timeTo            String?
  byAppointmentOnly Boolean            @default(false)
  logoUrl           String?
  bannerUrl              String?
  emailHeaderUrl         String?
  headerType             String             @default("AUTO")
  includeHeaderInInvoice Boolean            @default(true)
  includeHeaderInEmail   Boolean            @default(true)
  businessType           String             @default("sales")
  currency          String             @default("NGN")
  bankName          String?
  accountName       String?
  accountNumber     String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  postalCode          String?
  country             String             @default("Nigeria")
  senderPhone         String?
  enableStorePickup   Boolean            @default(true)
  pickupInstructions  String?
  enableHomeDelivery  Boolean            @default(true)
  freeDeliveryThreshold Decimal?         @db.Decimal(12, 2)
  fallbackShippingFee   Decimal?         @default(3000) @db.Decimal(12, 2)
  colors              Json?
  buttonRadius        String?            @default("Subtle")
  showServices        Boolean            @default(true)
  showPortfolio       Boolean            @default(true)
  showReviews         Boolean            @default(true)
  showFooterCta       Boolean            @default(true)
  footerEyebrow       String?
  footerTitle         String?
  footerDescription   String?
  googleReviewsLink   String?
  portfolioCategories String[]           @default([])

  // Storefront Customization
  showStorefrontBanner       Boolean            @default(true)
  storefrontBannerUrl         String?
  storefrontBannerHeader      String?
  storefrontBannerBody        String?
  storefrontBannerTextColor   String?
  storefrontBannerBgColor     String?
  showStorefrontSales         Boolean            @default(false)
  storefrontSalesPosition     String             @default("bottom")
  storefrontSalesUrl          String?
  storefrontSalesHeader       String?
  storefrontSalesBody         String?
  storefrontSalesBtnText      String?
  storefrontSalesBtnUrl       String?
  storefrontSalesLinkType     String?

  isPublished         Boolean            @default(false)
  isVerified          Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  businessUsers       BusinessUser[]
  socialChannels      SocialChannel[]
  portfolioProjects   PortfolioProject[]
  reviews             Review[]
  services            Service[]
  customers           Customer[]
  customerServices    CustomerService[]
  leads               Lead[]
  invoices            Invoice[]
  expenses            Expense[]
  broadcastCampaigns  BroadcastCampaign[]
  feedbackRequests    FeedbackRequest[]
  valuationRecords    ValuationRecord[]
  documentSequences   DocumentSequence[]
  products            Product[]
  categories          Category[]
  orders              Order[]
  checkoutSessions    CheckoutSession[]
  billing             BusinessBilling?
  paymentTransactions PaymentTransaction[]

  @@index([slug])
}

model BusinessUser {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  role       Role     @default(OWNER)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
}

model Service {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  category    String?
  description String?
  price       Decimal? @db.Decimal(12, 2)
  minPrice    Decimal? @db.Decimal(12, 2)
  maxPrice    Decimal? @db.Decimal(12, 2)
  priceType   String?  @default("fixed")
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([id, businessId])
  @@index([businessId])
}

model SocialChannel {
  id          String    @id @default(cuid())
  businessId  String
  type        String
  connected   Boolean   @default(false)
  label       String?
  handle      String?
  url         String?
  description String?
  lastSynced  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([id, businessId])
  @@index([businessId])
}

model PortfolioProject {
  id          String   @id @default(cuid())
  businessId  String
  title       String
  category    String?
  location    String?
  description String?
  image       String?
  order       Int      @default(0)
  isCover     Boolean  @default(false)
  gallery     String[] @default([])
  stats       String?
  client      String?
  year        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([id, businessId])
  @@index([businessId])
}

model Review {
  id         String   @id @default(cuid())
  businessId String
  author     String
  role       String?
  eventType  String?
  rating     Int      @default(5)
  comment    String
  date       String?
  avatar     String?
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([id, businessId])
  @@index([businessId])
}
