enum OrderStatus {
  OPEN
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  READY_FOR_PICKUP
  DISPATCHED
  DELIVERED
  RETURNED
  CANCELLED
}

enum DeliveryType {
  STORE_PICKUP
  HOME_DELIVERY
}

enum CheckoutSessionStatus {
  IN_PROGRESS
  ABANDONED
  CONVERTED
}

model Order {
  id                 String             @id @default(cuid())
  businessId         String
  customerId         String?
  orderNumber        String             @unique

  // Customer & Contact Snapshot
  customerName       String
  customerEmail      String
  customerPhone      String
  notes              String?

  // Financial Breakdown (Decimals for currency precision)
  currency           String             @default("NGN")
  subtotal           Decimal            @db.Decimal(12, 2)
  discountAmount     Decimal            @default(0) @db.Decimal(12, 2)
  deliveryFee        Decimal            @default(0) @db.Decimal(12, 2)
  platformFee        Decimal            @default(0) @db.Decimal(12, 2)
  merchantEarnings   Decimal            @db.Decimal(12, 2)
  total              Decimal            @db.Decimal(12, 2)

  // State Dimensions
  status             OrderStatus        @default(OPEN)
  paymentStatus      PaymentStatus      @default(UNPAID)
  fulfillmentStatus  FulfillmentStatus  @default(UNFULFILLED)

  // Delivery & Logistics Snapshot
  deliveryType       DeliveryType       @default(HOME_DELIVERY)
  shippingAddress    Json?
  pickupLocation     String?
  trackingNumber     String?
  courierName        String?
  terminalRateId     String?
  terminalShipmentId String?
  trackingUrl        String?
  estimatedDelivery  DateTime?
  fulfilledAt        DateTime?

  // Payment Integration (Paystack Split)
  paymentReference   String?            @unique
  paystackSubaccount String?
  paidAt             DateTime?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer           Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  fulfillments       OrderFulfillment[]
  transactions       PaymentTransaction[]
  logisticsEntries   LogisticsLedgerEntry[]

  @@unique([id, businessId])
  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, paymentStatus])
  @@index([businessId, fulfillmentStatus])
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  productId       String?
  variantId       String?

  // Immutable snapshot data
  productName     String
  variantTitle    String?
  productSku      String?
  productImage    String?
  unitPrice       Decimal         @db.Decimal(12, 2)
  quantity        Int             @default(1)
  totalPrice      Decimal         @db.Decimal(12, 2)
  selectedOptions Json?

  createdAt       DateTime        @default(now())

  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model CheckoutSession {
  id            String                @id @default(cuid())
  businessId    String
  customerEmail String?
  customerPhone String?
  customerName  String?
  cartSnapshot  Json
  subtotal      Decimal               @default(0) @db.Decimal(12, 2)
  status        CheckoutSessionStatus @default(IN_PROGRESS)
  expiresAt     DateTime
  convertedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([id, businessId])
  @@index([businessId])
  @@index([businessId, status])
  @@index([status, createdAt])
  @@index([expiresAt])
}

model OrderFulfillment {
  id             String            @id @default(cuid())
  orderId        String
  status             FulfillmentStatus
  trackingNumber     String?
  courierName        String?
  terminalShipmentId String?
  trackingUrl        String?
  notes              String?
  notifiedBuyer      Boolean           @default(false)
  createdAt      DateTime          @default(now())

  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
